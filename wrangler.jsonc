/**
 * =========================================================
 * NEXO BACKEND — CLOUDFLARE WORKER
 * =========================================================
 *
 * Configuração oficial do Worker responsável pelo backend
 * do NEXO.
 *
 * Dados sensíveis NÃO devem ser colocados neste arquivo.
 *
 * Secrets configuradas diretamente no Cloudflare:
 *
 * - FIREBASE_CLIENT_EMAIL
 * - FIREBASE_PRIVATE_KEY
 *
 * Variáveis públicas/de configuração podem permanecer aqui.
 */

{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "nexo-backend",

	"main": "src/index.ts",

	"compatibility_date": "2026-08-16",

	/**
	 * =====================================================
	 * OBSERVABILIDADE
	 * =====================================================
	 */

	"observability": {
		"enabled": true
	},

	"upload_source_maps": true,

	/**
	 * =====================================================
	 * VARIÁVEIS DE AMBIENTE
	 * =====================================================
	 *
	 * FIREBASE_PROJECT_ID não é uma credencial secreta.
	 *
	 * Declaramos aqui para que ela acompanhe todos os
	 * deployments feitos através do GitHub / Wrangler.
	 *
	 * NÃO colocar aqui:
	 *
	 * FIREBASE_CLIENT_EMAIL
	 * FIREBASE_PRIVATE_KEY
	 */

	"vars": {
		"FIREBASE_PROJECT_ID": "nexo-15b2c"
	}

	/**
	 * =====================================================
	 * CONFIGURAÇÕES FUTURAS
	 * =====================================================
	 */

	// Smart Placement:
	// "placement": {
	// 	"mode": "smart"
	// }

	// Static Assets:
	// "assets": {
	// 	"directory": "./public/",
	// 	"binding": "ASSETS"
	// }

	// Service Bindings:
	// "services": [
	// 	{
	// 		"binding": "MY_SERVICE",
	// 		"service": "my-service"
	// 	}
	// ]
}