# =============================================================
# NEXO — Variáveis de ambiente (frontend)
# =============================================================
#
# Copie este arquivo para .env.local e preencha com os valores
# reais. NUNCA commite o .env.local (já está no .gitignore).
#
# A configuração pública do Firebase (apiKey, projectId, etc.)
# não fica aqui — ela é pública por natureza e já está em
# src/firebase.ts e src/sw.ts. O que precisa vir de variável de
# ambiente é a VAPID key, usada para registrar o navegador no
# Firebase Cloud Messaging.
# =============================================================

# Chave pública VAPID do projeto Firebase (Cloud Messaging > Web
# Push certificates). Necessária para o navegador gerar o token
# de notificação push.
VITE_FIREBASE_VAPID_KEY=
